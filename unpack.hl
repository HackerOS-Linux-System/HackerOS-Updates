using <gen 2>
// curl
// awk

;; ── Stale ────────────────────────────────────────────────────────────────────
% MANIFEST_URL = https://raw.githubusercontent.com/HackerOS-Linux-System/HackerOS/main/packages/manifest.hk
% GH = https://github.com/HackerOS-Linux-System
% SHARE = /usr/share/HackerOS
% NEW_DIR = /usr/share/.HackerOS_new
% OLD_DIR = /usr/share/.HackerOS_old
% LIBS_DIR = /usr/lib/HackerOS/Hacker-Lang/main-libs
% STATE_FILE = /var/lib/hackeros-updates/installed.hk
% APPS_DIR = /usr/share/HackerOS/Scripts/HackerOS-Apps
% GAMES_DIR = /usr/share/HackerOS/Scripts/HackerOS-Games
% STEAM_BIN = /usr/share/HackerOS/Scripts/Steam/bin
% UPD_OK = 0
% UPD_SAME = 0
% UPD_SKIP = 0
% UPD_FAIL = 0
% FAILED_LIST =
% T_VERIFY =
% T_AS =

;; ── Licznik / raport ─────────────────────────────────────────────────────────
: c_ok def
    $( @UPD_OK + 1 ) -> @UPD_OK
done
: c_same def
    $( @UPD_SAME + 1 ) -> @UPD_SAME
done
: c_skip def
    $( @UPD_SKIP + 1 ) -> @UPD_SKIP
done
: c_fail def
    $( @UPD_FAIL + 1 ) -> @UPD_FAIL
    % FAILED_LIST = @FAILED_LIST @T_NAME
done

;; ── Sprzatanie i zakonczenie ─────────────────────────────────────────────────
: cleanup def
    > rm -rf @WORK
done

;; ── Instalacja jednego pliku ─────────────────────────────────────────────────
;; Wejscie: T_KEY (klucz w manifest.hk), T_REPO, T_ASSET, T_DIR, T_SUDO (yes/no),
;;          T_MODE (required/optional), T_AS (opcjonalna nazwa docelowa),
;;          T_VERIFY (hl = sprawdz binarke po instalacji, rollback przy bledzie)

: tool_kind def
    >> printf '%s' '@T_ASSET' | grep -q '[.]love$' && echo zip || echo bin |> @T_KIND
done

: stage_version def
    % _hk_file = @MANIFEST
    % _hk_section = tools
    % _hk_key = @T_KEY
    -- hk_get
    ? switch @_hk_found
    | true
        % T_VER = @_hk_result
        >> printf '%s' '@T_VER' | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$' && echo ok || echo bad |> @T_VOK
        ? switch @T_VOK
        | ok
            % T_RES = go
        | *
            ::red @T_NAME - niepoprawna wersja w manifest.hk: [@T_VER] - pomijam
            % T_RES = fail
        done
    | *
        ::yellow @T_NAME - brak wpisu "@T_KEY" w manifest.hk [tools] - pomijam
        % T_RES = skip
    done
done

: stage_present def
    ;; optional: aktualizuj tylko jesli juz zainstalowane
    ? switch @T_MODE
    | optional
        >> test -e "@T_DEST" && echo yes || echo no |> @T_PRESENT
        ? switch @T_PRESENT
        | yes
            % T_RES = go
        | *
            % T_RES = silent
        done
    | *
        % T_RES = go
    done
done

: stage_uptodate def
    ? switch @FORCE
    | yes
        % T_RES = go
    | *
        % _hk_file = @STATE_FILE
        % _hk_section = installed
        % _hk_key = @T_DEST
        -- hk_get
        >> test "@_hk_result" = "@T_VER" -a -s "@T_DEST" && echo same || echo diff |> @T_SAME
        ? switch @T_SAME
        | same
            % T_RES = same
        | *
            % T_RES = go
        done
    done
done

: stage_download def
    % T_URL = @GH/@T_REPO/releases/download/@T_VER/@T_ASSET
    % T_TMP = @WORK/dl.@T_ASSET
    > rm -f @T_TMP
    >> curl -fsSL --retry 3 --retry-delay 2 --connect-timeout 15 --max-time 900 -o "@T_TMP" "@T_URL" && echo ok || echo fail |> @T_DL
    ? switch @T_DL
    | ok
        % T_RES = go
    | *
        ::red @T_NAME @T_VER - blad pobierania: @T_URL
        % T_RES = fail
    done
done

: stage_validate def
    >> test -s "@T_TMP" && echo ok || echo empty |> @T_SIZE
    ? switch @T_SIZE
    | ok
        >> od -An -tx1 -N4 "@T_TMP" | tr -d '[:space:]' |> @T_MAGIC
        ? switch @T_KIND
        | zip
            >> printf '%s' '@T_MAGIC' | grep -q '^504b0304' && echo ok || echo bad |> @T_VAL
        | *
            >> printf '%s' '@T_MAGIC' | grep -Eq '^(7f454c46|2321)' && echo ok || echo bad |> @T_VAL
        done
        ? switch @T_VAL
        | ok
            % T_RES = go
        | *
            ::red @T_NAME - pobrany plik ma zly format (nie ELF/skrypt/zip) - nie instaluje
            % T_RES = fail
        done
    | *
        ::red @T_NAME - pobrany plik jest pusty - nie instaluje
        % T_RES = fail
    done
done

: stage_install def
    % T_NEWF = @T_DEST.new
    ? switch @T_SUDO
    | yes
        ^> install -D -m 755 -o root -g root "@T_TMP" "@T_NEWF" && mv -f "@T_NEWF" "@T_DEST" && echo ok || (rm -f "@T_NEWF"; echo fail) |> @T_IN
    | *
        >> install -D -m 755 "@T_TMP" "@T_NEWF" && mv -f "@T_NEWF" "@T_DEST" && echo ok || (rm -f "@T_NEWF"; echo fail) |> @T_IN
    done
    ? switch @T_IN
    | ok
        % T_RES = go
    | *
        ::red @T_NAME - instalacja do @T_DEST nie powiodla sie
        % T_RES = fail
    done
done

: stage_verify def
    ;; po instalacji hl: sprawdz czy nowa binarka daje sie uruchomic (kody 126/127 =
    ;; nie startuje, 132/134/139 = crash), inaczej rollback do poprzedniej wersji.
    ;; Kod 1 (np. blokada "tylko HackerOS") oznacza, ze binarka dziala.
    ? switch @T_VERIFY
    | hl
        >> "@T_DEST" version > /dev/null 2>&1; r=$?; case $r in 126|127|132|134|135|139) echo bad;; *) echo ok;; esac |> @T_HLV
        ? switch @T_HLV
        | ok
            % T_RES = go
        | *
            ? switch @T_HAVEBAK
            | yes
                ::red hl - nowa binarka sie nie uruchamia, przywracam poprzednia wersje
                ^> install -m 755 -o root -g root "@WORK/hl.bak" "@T_DEST" && echo ok || echo fail |> @T_RB
            | *
                ::red hl - nowa binarka sie nie uruchamia (brak kopii poprzedniej wersji)
            done
            % T_RES = fail
        done
    | *
        % T_RES = go
    done
done

: stage_backup def
    % T_HAVEBAK = no
    ? switch @T_VERIFY
    | hl
        > rm -f @WORK/hl.bak
        >> test -f "@T_DEST" && cp -p "@T_DEST" "@WORK/hl.bak" && echo yes || echo no |> @T_HAVEBAK
    done
done

: stage_record def
    >> printf '%s\n' '-> "@T_DEST" => @T_VER' >> "@STATE_NEW"
done

: install_tool def
    % T_RES = go
    % T_NAME = @T_ASSET
    -- stage_version
    ? switch @T_RES
    | go
        -- stage_present
    done
    ? switch @T_RES
    | go
        -- stage_uptodate
    done
    ? switch @T_RES
    | go
        -- stage_download
    done
    ? switch @T_RES
    | go
        -- stage_validate
    done
    ? switch @T_RES
    | go
        -- stage_backup
        -- stage_install
    done
    ? switch @T_RES
    | go
        -- stage_verify
    done
    ? switch @T_RES
    | go
        ::green @T_NAME @T_VER - zaktualizowano
        -- stage_record
        -- c_ok
    | same
        ::cyan @T_NAME @T_VER - aktualne
        -- stage_record
        -- c_same
    | skip
        -- c_skip
    | silent
        -- c_skip
    | *
        -- c_fail
    done
done

;; jeden plik: dest = T_DIR/T_ASSET (lub T_DIR/T_AS)
: tool_asset def
    -- tool_kind
    >> test -n "@T_AS" && echo as || echo plain |> @T_ASM
    ? switch @T_ASM
    | as
        % T_DEST = @T_DIR/@T_AS
    | *
        % T_DEST = @T_DIR/@T_ASSET
    done
    -- install_tool
done

;; ── KROK 0: kontrola srodowiska, odzysk po przerwanej aktualizacji ──────────
::bold === HackerOS Updates - unpack.hl ===
>> test "@arg0" = "force" && echo yes || echo no |> @FORCE
>> bash -c 'if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != root ]; then getent passwd "$SUDO_USER" | cut -d: -f6; else printf %s "$HOME"; fi' |> @USER_HOME
>> mktemp -d /tmp/hackeros-update.XXXXXX |> @WORK
% STATE_NEW = @WORK/installed.hk
> printf '[installed]\n' > @STATE_NEW
>> test -n "@HOS_MANIFEST_URL" && echo yes || echo no |> @OVR
? switch @OVR
| yes
    % MANIFEST_URL = @HOS_MANIFEST_URL
    ::yellow Uzyto HOS_MANIFEST_URL: @MANIFEST_URL
done

;; katalog z repo aktualizacji (tam gdzie lezy ten skrypt, domyslnie /tmp/HackerOS-Updates)
>> dirname "$(readlink -f '@HL_SCRIPT')" |> @UPD_DIR
>> test -d "@UPD_DIR/HackerOS" && echo yes || echo no |> @UPD_OK_DIR
? switch @UPD_OK_DIR
| yes
    ;; ok
| *
    % UPD_DIR = /tmp/HackerOS-Updates
done
::cyan Repo aktualizacji: @UPD_DIR  |  uzytkownik: @USER_HOME

;; odzysk po przerwanej podmianie /usr/share/HackerOS
^> bash -c 'if [ ! -d @SHARE ] && [ -d @OLD_DIR ]; then mv @OLD_DIR @SHARE; fi; rm -rf @NEW_DIR' && echo ok || echo fail |> @REC

;; ── KROK 1: biblioteka main/hk-parser + manifest.hk ──────────────────────────
::bold [1/9] Biblioteka hk-parser i manifest.hk
>> test -f "@UPD_DIR/main-libs/hk-parser.hl" && echo yes || echo no |> @HAVE_LIB
? switch @HAVE_LIB
| yes
    >> cmp -s "@UPD_DIR/main-libs/hk-parser.hl" "@LIBS_DIR/hk-parser.hl" && echo same || echo diff |> @LIB_SAME
    ? switch @LIB_SAME
    | same
        ::cyan hk-parser.hl aktualny
    | *
        ^> install -D -m 644 -o root -g root "@UPD_DIR/main-libs/hk-parser.hl" "@LIBS_DIR/hk-parser.hl" && echo ok || echo fail |> @LIB_IN
        ? switch @LIB_IN
        | ok
            ::green hk-parser.hl zaktualizowany
        | *
            ::red Nie mozna zainstalowac hk-parser.hl w @LIBS_DIR
            -- cleanup
            > exit 1
        done
    done
| *
    ::red Brak @UPD_DIR/main-libs/hk-parser.hl - niekompletne repo aktualizacji
    -- cleanup
    > exit 1
done

# <main/hk-parser>

% MANIFEST = @WORK/manifest.hk
::cyan Pobieranie manifestu: @MANIFEST_URL
>> curl -fsSL --retry 3 --retry-delay 2 --connect-timeout 15 --max-time 60 -o "@MANIFEST" "@MANIFEST_URL" && echo ok || echo fail |> @MF
? switch @MF
| ok
    ;; ok
| *
    ::red Nie mozna pobrac manifest.hk - przerywam, system NIE zostal zmieniony
    -- cleanup
    > exit 1
done

% _hk_file = @MANIFEST
-- hk_is_valid
? switch @_hk_found
| true
    ;; ok
| *
    ::red manifest.hk ma niepoprawny format - przerywam, system NIE zostal zmieniony
    -- cleanup
    > exit 1
done
% _hk_section = tools
-- hk_load_section
? switch @_hk_found
| true
    ::green Manifest OK - narzedzi w [tools]: @HK_tools_COUNT
| *
    ::red manifest.hk nie zawiera sekcji [tools] - przerywam, system NIE zostal zmieniony
    -- cleanup
    > exit 1
done

;; ── KROK 2: struktura /usr/share/HackerOS (podmiana z rollbackiem) ───────────
::bold [2/9] Struktura /usr/share/HackerOS
>> test -f "@UPD_DIR/HackerOS/Config-Files/release-info.json" && echo ok || echo bad |> @SRC_OK
? switch @SRC_OK
| ok
    ;; ok
| *
    ::red Brak @UPD_DIR/HackerOS/Config-Files/release-info.json - przerywam
    -- cleanup
    > exit 1
done
^> bash -c 'set -e; rm -rf @NEW_DIR @OLD_DIR; cp -a @UPD_DIR/HackerOS @NEW_DIR; keep() { if [ -d @SHARE/$1 ]; then mkdir -p @NEW_DIR/$1; cp -au @SHARE/$1/. @NEW_DIR/$1/; fi; }; keep Scripts/HackerOS-Apps; keep Scripts/HackerOS-Games; keep Scripts/Steam/bin; chown -R root:root @NEW_DIR; if [ -d @SHARE ]; then mv @SHARE @OLD_DIR; fi; if mv @NEW_DIR @SHARE; then rm -rf @OLD_DIR; else if [ -d @OLD_DIR ]; then mv @OLD_DIR @SHARE; fi; exit 1; fi; echo ok' || (rm -rf @NEW_DIR; echo fail) |> @SWAP
? switch @SWAP
| ok
    ::green Struktura zaktualizowana (pobrane aplikacje i gry zachowane)
| *
    ::red Podmiana struktury nie powiodla sie - system zostal przywrocony
    -- cleanup
    > exit 1
done
^> find @SHARE -type f -name "*.hl" -exec chmod 755 {} + && find @SHARE -type f -name "*.sh" -exec chmod 755 {} + && echo ok || echo fail |> @CHM

;; ── KROK 3: aplikacje (HackerOS-Apps) ────────────────────────────────────────
::bold [3/9] Aplikacje
% T_SUDO = yes
% T_MODE = required
% T_DIR = @APPS_DIR
% T_KEY = HackerOS Store
% T_REPO = HackerOS-Store
% T_ASSET = HackerOS-Store
-- tool_asset
% T_KEY = Hacker Launcher
% T_REPO = Hacker_Launcher
% T_ASSET = Hacker_Launcher
-- tool_asset
% T_KEY = Proton Manager
% T_REPO = Proton-Manager
% T_ASSET = proton-manager
-- tool_asset
% T_KEY = Hacker Term
% T_REPO = Hacker-Term
% T_ASSET = Hacker-Term
-- tool_asset
% T_KEY = HackerOS Welcome
% T_REPO = HackerOS-Welcome
% T_ASSET = HackerOS-Welcome
-- tool_asset

;; ── KROK 4: gry ──────────────────────────────────────────────────────────────
::bold [4/9] Gry
% T_DIR = @GAMES_DIR
% T_KEY = HackerOS Games
% T_REPO = HackerOS-Games
@ a in HackerOS-Games the-racer starblaster bit-jump.love cosmonaut.love bark-squadron
    % T_ASSET = @a
    -- tool_asset
done

;; ── KROK 5: Steam ────────────────────────────────────────────────────────────
::bold [5/9] HackerOS Steam
% T_DIR = @STEAM_BIN
% T_KEY = HackerOS Steam
% T_REPO = HackerOS-Steam
@ a in gui tui
    % T_ASSET = @a
    -- tool_asset
done

;; ── KROK 6: narzedzia CLI w /usr/bin ─────────────────────────────────────────
::bold [6/9] Narzedzia /usr/bin
% T_DIR = /usr/bin
% T_KEY = hacker
% T_REPO = Hacker-CLI-Tool
% T_ASSET = hacker
-- tool_asset
% T_KEY = hnm
% T_REPO = HackerOS-Nix-Manager
% T_ASSET = hnm
-- tool_asset
% T_KEY = hpm
% T_REPO = HackerOS-Package-Manager
% T_ASSET = hpm
-- tool_asset
% T_KEY = chker
% T_REPO = chker
% T_ASSET = chker
-- tool_asset
% T_KEY = getit
% T_REPO = getit
% T_ASSET = getit
-- tool_asset
% T_KEY = HackerOS Steam
% T_REPO = HackerOS-Steam
% T_ASSET = hackeros-steam
-- tool_asset
% T_KEY = hsh
% T_REPO = hsh
% T_ASSET = hsh
-- tool_asset
% T_KEY = ngt
% T_REPO = ngt
% T_ASSET = ngt
-- tool_asset
% T_KEY = hedit
% T_REPO = hedit
% T_ASSET = hedit
-- tool_asset

;; ── KROK 7: edycje opcjonalne (tylko jesli juz zainstalowane) ────────────────
::bold [7/9] Pakiety opcjonalne (aktualizowane tylko jesli zainstalowane)
% T_MODE = optional
% T_KEY = gaming-cli
% T_REPO = gaming-cli
@ a in gamescope-manager gaming gaming-cli
    % T_ASSET = @a
    -- tool_asset
done
% T_KEY = Hacker Mode
% T_REPO = Hacker-Mode
% T_ASSET = Hacker-Mode
-- tool_asset
% T_KEY = hammer
% T_REPO = hammer
% T_ASSET = hammer
-- tool_asset
% T_KEY = HWDE
% T_REPO = HWDE
% T_ASSET = hwde
-- tool_asset
% T_KEY = HackerScript
% T_REPO = HackerScript
% T_ASSET = hackerc
-- tool_asset
% T_KEY = H#
% T_REPO = H-Sharp
% T_ASSET = hsharp
% T_AS = h#
-- tool_asset
% T_AS =
% T_KEY = bit
% T_REPO = bit
% T_ASSET = bit
-- tool_asset
% T_KEY = HackerOS Builder
% T_REPO = HackerOS-Builder
% T_ASSET = hackeros-builder
-- tool_asset
% T_MODE = required

;; ── KROK 8: konfiguracja uzytkownika (~/.hackeros/hacker) ────────────────────
::bold [8/9] Konfiguracja uzytkownika
% T_SUDO = no
% T_DIR = @USER_HOME/.hackeros/hacker
% T_KEY = hacker
% T_REPO = Hacker-CLI-Tool
@ a in hacker-shell hacker-repair hacker-help hacker-select hacker-docs HackerOS-Updater update-system apt-frontend
    % T_ASSET = @a
    -- tool_asset
done
>> bash -c 'if [ "$(id -u)" = 0 ] && [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != root ]; then chown -R "$SUDO_USER": "@USER_HOME/.hackeros"; fi' && echo ok || echo fail |> @CHO
% T_SUDO = yes

;; ── KROK 9: Hacker Lang (na koncu - podmienia interpreter) ───────────────────
::bold [9/9] Hacker Lang
% T_DIR = /usr/bin
% T_KEY = Hacker Lang
% T_REPO = Hacker-Lang
% T_ASSET = hl
% T_VERIFY = hl
-- tool_asset
% T_VERIFY =

;; ── Stan zainstalowanych wersji + podsumowanie ───────────────────────────────
^> install -D -m 644 -o root -g root "@STATE_NEW" "@STATE_FILE" && echo ok || echo fail |> @ST
-- cleanup
::bold === Podsumowanie ===
~> Zaktualizowano: @UPD_OK | Aktualne: @UPD_SAME | Pominiete: @UPD_SKIP | Bledy: @UPD_FAIL
? switch @UPD_FAIL
| 0
    ::green HackerOS zaktualizowany pomyslnie.
| *
    ::red Nie udalo sie zaktualizowac: @FAILED_LIST
    ::yellow Uruchom aktualizacje ponownie, nieudane pliki zostana pobrane jeszcze raz.
    > exit 1
done
