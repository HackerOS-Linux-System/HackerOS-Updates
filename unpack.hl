% T_MODE = required

;; ── KROK 8: konfiguracja uzytkownika (~/.hackeros/hacker) ────────────────────
::bold [8/9] Konfiguracja uzytkownika
? switch @NOUSER
| yes
    ::cyan Pominieto (tryb systemowy/automatyczny) - zostanie zaktualizowana przy nastepnym recznym update
| *
    % T_SUDO = no
    % T_DIR = @USER_HOME/.hackeros/hacker
    % T_KEY = hacker
    % T_REPO = Hacker-CLI-Tool
    @ a in hacker-shell hacker-repair hacker-help hacker-select hacker-docs HackerOS-Updater update-system apt-frontend
        % T_ASSET = @a
        -- tool_asset
    done
    ? switch @CHECK
    | yes
        ;; bez zmian
    | *
        >> bash -c 'if [ "$(id -u)" = 0 ] && [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != root ]; then chown -R "$SUDO_USER": "@USER_HOME/.hackeros"; fi' && echo ok || echo fail |> @CHO
    done
    % T_SUDO = yes
done

;; ── KROK 9: Hacker Lang (na koncu - podmienia interpreter) ───────────────────
::bold [9/9] Hacker Lang
% T_DIR = /usr/bin
% T_KEY = Hacker Lang
% T_REPO = Hacker-Lang
% T_ASSET = hl
% T_VERIFY = hl
-- tool_asset
% T_VERIFY =

;; ── Podsumowanie, stan, kod wyjscia ──────────────────────────────────────────
? switch @CHECK
| yes
    ;; nic
| *
    -- units_step
done
::bold === Podsumowanie ===
? switch @CHECK
| yes
    ~> Do aktualizacji: @UPD_PEND | Aktualne: @UPD_SAME | Wstrzymane: @UPD_HELD | Pominiete: @UPD_SKIP | Bledy: @UPD_FAIL
    ? switch @UPD_PEND
    | 0
        ::green Wszystko aktualne - nic do zrobienia.
        % RC = 0
    | *
        ::yellow Dostepne aktualizacje: @UPD_PEND
        % RC = 10
    done
| *
    ~> Zaktualizowano: @UPD_OK | Aktualne: @UPD_SAME | Wstrzymane: @UPD_HELD | Pominiete: @UPD_SKIP | Bledy: @UPD_FAIL
    -- write_state
    ? switch @UPD_FAIL
    | 0
        >> test "@UPD_OK" = "0" -a "@TREE_ACT" != "swap" && echo nic || echo zmiany |> @ZM
        ? switch @ZM
        | nic
            ::green Wszystko aktualne - nic nie zmieniono.
        | *
            ::green HackerOS zaktualizowany pomyslnie.
        done
        % RC = 0
    | *
        ::red Nie udalo sie zaktualizowac: @FAILED_LIST
        ::yellow Uruchom aktualizacje ponownie, nieudane pliki zostana pobrane jeszcze raz.
        % RC = 1
    done
    -- write_lastrun
done
-- cleanup
-- do_exit
